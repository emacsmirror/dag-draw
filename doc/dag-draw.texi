@node Constructing Graphs
@section Constructing Graphs

@defun dag-draw-create-graph &optional attributes
Create and return a new empty graph.  ATTRIBUTES is an optional hash
table of graph-level attributes.
@end defun

@defun dag-draw-create-from-spec &rest spec
Create a graph from a declarative specification and return it
@emph{unlaid-out}; call @code{dag-draw-layout-graph} before rendering.  SPEC is a
property list with two required keys:

@table @asis
@item @code{:nodes}
A list of node specifications.  Each is @code{(id :label
    "Label" ...attrs)}, where ID is a symbol and @code{:label} is required.
Remaining keyword properties become node attributes (see
@ref{Node Attributes}).
@item @code{:edges}
A list of edge specifications.  Each is @code{(from to
    ...attrs)}, where FROM and TO are node ids.  Remaining keyword
properties become edge attributes (see @ref{Edge Attributes});
@code{:weight} and @code{:label} are recognized specially.
@end table

Signals an error if @code{:nodes} or @code{:edges} is missing, if a node lacks
@code{:label}, if a node id is duplicated, or if an edge references an
unknown node.
@end defun

@defun dag-draw-add-node graph node-id &optional label attributes
Add a node to GRAPH and return the created node.  NODE-ID is a unique
symbol.  LABEL is the display string (defaults to the symbol name).
ATTRIBUTES is an optional hash table of node attributes.  The node is
auto-sized to fit its label.
@end defun

@defun dag-draw-add-edge graph from-node to-node &optional weight label attributes
Add an edge from FROM-NODE to TO-NODE in GRAPH and return it.  WEIGHT
defaults to @code{1}.  LABEL is an optional edge label.  ATTRIBUTES is an
optional hash table; a @code{min-length} key sets the minimum rank span
(default @code{1}).
@end defun

@node Laying Out
@section Laying Out

@defun dag-draw-layout-graph graph &rest args
Run the GKNV layout algorithm on GRAPH in place and return it.  This
performs four passes: rank assignment, vertex ordering, coordinate
positioning, and spline (edge route) generation.  ARGS accepts one
keyword:

@table @asis
@item @code{:coordinate-mode}
@code{ascii} (the default) produces compact integer
coordinates suited to terminal output; @code{high-res} is a legacy
high-resolution mode.
@end table
@end defun

@node Rendering
@section Rendering

@defun dag-draw-render-graph graph &optional format selected
Render a laid-out GRAPH and return a string.  FORMAT is one of:

@table @asis
@item @code{ascii}
Monospace Unicode box-drawing art.
@item @code{svg}
A complete SVG document.
@item @code{dot}
Graphviz DOT source.
@end table

When FORMAT is omitted, @code{dag-draw-default-output-format} is used.
SELECTED is an optional node id to emphasize: a double-line box in
ASCII, a glow filter in SVG, @code{style=bold} in DOT@.
@end defun

@node Querying
@section Querying

@defun dag-draw-get-node graph node-id
Return the node structure for NODE-ID, or @code{nil}.
@end defun

@defun dag-draw-graph-edges graph
Return the list of all edge structures in GRAPH@.
@end defun

@defun dag-draw-get-edges-from graph node-id
Return the list of edges whose source is NODE-ID@.
@end defun

@defun dag-draw-get-edges-to graph node-id
Return the list of edges whose target is NODE-ID@.
@end defun

@defun dag-draw-find-edge graph from-node to-node
Return the edge from FROM-NODE to TO-NODE, or @code{nil}.
@end defun

@defun dag-draw-get-node-ids graph
Return the list of all node ids.
@end defun

@defun dag-draw-node-count graph
Return the number of nodes.
@end defun

@defun dag-draw-edge-count graph
Return the number of edges.
@end defun

@defun dag-draw-get-successors graph node-id
Return the list of node ids directly reachable from NODE-ID@.
@end defun

@defun dag-draw-get-predecessors graph node-id
Return the list of node ids that point directly to NODE-ID@.
@end defun

@defun dag-draw-get-source-nodes graph
Return the list of node ids that have no incoming edges.
@end defun

@defun dag-draw-get-graph-bounds graph
Return @code{(min-x min-y max-x max-y)}, the bounding rectangle of the
positioned graph.  Call after @code{dag-draw-layout-graph}.
@end defun

@defun dag-draw-detect-cycles graph
Return the list of back-edges (edge structures) that close a cycle, or
@code{nil} if GRAPH is acyclic.  See @ref{Detecting Cycles}.
@end defun

@node Mutating
@section Mutating

@defun dag-draw-remove-node graph node-id
Remove the node NODE-ID from GRAPH@.
@end defun

@defun dag-draw-remove-edge graph from-node to-node
Remove the edge from FROM-NODE to TO-NODE from GRAPH@.
@end defun

@node Struct Accessors
@section Struct Accessors

After layout, node fields hold the computed geometry.  These accessors
read node, edge, and graph fields.  Coordinates and ranks are @code{nil} until
@code{dag-draw-layout-graph} has run.

@defun dag-draw-node-label node
Return the node's display label.
@end defun

@defun dag-draw-node-rank node
Return the node's assigned rank.
@end defun

@defun dag-draw-node-x-coord node
Return the node's x center coordinate.
@end defun

@defun dag-draw-node-y-coord node
Return the node's y center coordinate.
